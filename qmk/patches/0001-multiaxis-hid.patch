+# compiled automatically by QMK (it matches the keyboard directory name).
+#SRC += orbit_logic.c \
+#       orbit_config.c \
+#       orbit_axes.c \
+#       orbit_chords.c \
+#       orbit_slicer.c \
+#       orbit_6dof.c \
