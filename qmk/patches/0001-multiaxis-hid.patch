diff --git a/keyboards/hackman3d/orbit_controller/orbit_controller.h b/keyboards/hackman3d/orbit_controller/orbit_controller.h
new file mode 100644
index 0000000000..91adbd67f0
--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/orbit_controller.h
@@ -0,0 +1,103 @@
+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include QMK_KEYBOARD_H
+#include <stdint.h>
+#include <stdbool.h>
+
+/* ========================================================================
+ * Layers
+ * ===================================================================== */
+enum orbit_layers {
+    _BASE        = 0,  // 6DOF mode
+    _SLICER      = 1,  // slicer mouse mode, short-press actions
+    _SLICER_LONG = 2,  // slicer mouse mode, long-press actions
+};
+
+/* ========================================================================
+ * Hardware
+ * ===================================================================== */
+
+#define ORBIT_SENSOR_COUNT 8
+#define ORBIT_BUTTON_COUNT 3
+
+/* Analog channel order is load-bearing: the axis math in orbit_axes.c refers
+ * to sensors by their index in this array, mirroring pins[8] in the Arduino
+ * firmware ({A1, A0, A3, A2, A7, A6, A9, A8}).
+ *
+ *   idx | Arduino | 32U4 | ADC   | QMK
+ *   ----+---------+------+-------+----
+ *    0  | A1      | PF6  | ADC6  | F6
+ *    1  | A0      | PF7  | ADC7  | F7
+ *    2  | A3      | PF4  | ADC4  | F4
+ *    3  | A2      | PF5  | ADC5  | F5
+ *    4  | A7      | PD7  | ADC10 | D7
+ *    5  | A6      | PD4  | ADC8  | D4
+ *    6  | A9      | PB5  | ADC12 | B5
+ *    7  | A8      | PB4  | ADC11 | B4
+ *
+ * NOTE: A0 = PF7 and A1 = PF6 on the Pro Micro - the Arduino analog numbering
+ * runs opposite to the port bit numbering. The mapping above is correct; do
+ * not "fix" the apparent transposition.
+ *
+ * Even indices (0,2,4,6) are the push/pull group, odd (1,3,5,7) the twist
+ * group. See qmk/01_FIRMWARE_INVENTORY.md section 3.
+ */
+extern const pin_t orbit_analog_pins[ORBIT_SENSOR_COUNT];
+
+/* Pro Micro on-board LEDs, both active LOW. */
+#define ORBIT_LED_TX D5
+#define ORBIT_LED_RX B0
+
+/* ========================================================================
+ * 6DOF axis output
+ *
+ * Produced by orbit_axes_task() once per scan and consumed by both
+ * orbit_6dof.c (multi-axis reports) and orbit_slicer.c (mouse deltas).
+ * The slicer path must READ this cache, never re-run the pipeline - the
+ * pipeline carries smoothing state and running it twice per scan would
+ * double the smoothing rate.
+ * ===================================================================== */
+typedef struct {
+    int16_t tx, ty, tz;
+    int16_t rx, ry, rz;
+} orbit_axes_t;
+
+extern orbit_axes_t orbit_axes;
+
+/* ========================================================================
+ * Module entry points
+ * ===================================================================== */
+
+/* orbit_axes.c */
+void orbit_axes_init(void);
+void orbit_axes_task(void);
+void orbit_calibrate_center(void);
+void orbit_reset_smoothing(void);
+bool orbit_calibration_failed(void);
+
+/* orbit_chords.c */
+void     orbit_chords_task(void);
+uint32_t orbit_hid_button_mask(void);
+uint32_t orbit_raw_button_mask(void);
+bool     orbit_chord_active(void);
+
+/* orbit_6dof.c */
+void orbit_6dof_send(int16_t rx, int16_t ry, int16_t rz,
+                     int16_t x,  int16_t y,  int16_t z);
+void orbit_6dof_send_buttons(uint32_t buttons);
+
+/* orbit_slicer.c */
+bool orbit_slicer_enabled(void);
+void orbit_slicer_set_enabled(bool enabled);
+void orbit_slicer_keys_task(void);
+void orbit_slicer_release_buttons(void);
+
+/* orbit_leds.c */
+void orbit_leds_init(void);
+void orbit_leds_task(void);
+void orbit_leds_signal_speed_mode(uint8_t mode);
+void orbit_leds_signal_slicer_mode(bool enabled);
+void orbit_leds_flash_calibration_error(void);
diff --git a/keyboards/hackman3d/orbit_controller/readme.md b/keyboards/hackman3d/orbit_controller/readme.md
new file mode 100644
index 0000000000..c38819a956
--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/readme.md
@@ -0,0 +1,83 @@
+# HackMan3D Orbit Controller
+
+A DIY 6DOF SpaceMouse-compatible controller: four JH16 Hall-effect joysticks (8 analog
+channels) plus 3 buttons on an Arduino Pro Micro (ATmega32U4).
+
+This is the QMK port of the Arduino firmware. Design docs, the porting task list, and the
+VIA definition JSON live in the project repo:
+<https://github.com/HackMan3D/HackMan3D-Orbit-Controller> under `qmk/`.
+
+* Keyboard Maintainer: [HackMan3D](https://github.com/HackMan3D)
+* Hardware Supported: Arduino Pro Micro (ATmega32U4), 4x JH16 joystick, 3x button
+* Hardware Availability: <https://github.com/HackMan3D/HackMan3D-Orbit-Controller>
+
+## Status
+
+**Work in progress — scaffold only.** See `qmk/06_TASKLIST.md` in the project repo for the
+phased plan. Currently implements Phase 2 (builds and enumerates); the axis pipeline, chord
+logic, slicer mouse mode and VIA live tuning are not yet wired up.
+
+## Requires a patched QMK
+
+This keyboard emits a **3Dconnexion-style Multi-axis Controller** HID descriptor (Generic
+Desktop usage `0x08`, with translation / rotation / button split across Report IDs 1/2/3).
+Stock QMK's joystick feature is hardcoded to usage `0x04` (Joystick) with a single combined
+report, which the 3DxWare driver will not bind to.
+
+The port therefore depends on a small patch to `tmk_core/protocol/` gated behind
+`JOYSTICK_MULTIAXIS_ENABLE`. See `qmk/03_HID_DESCRIPTOR_FORK.md` in the project repo, and
+`qmk/patches/` for the patch itself.
+
+Without that patch this keyboard will build but present as a generic 6-axis joystick.
+
+## Building
+
+    make hackman3d/orbit_controller:default        # 6DOF only
+    make hackman3d/orbit_controller:viam           # + VIA live keymap & tuning
+    make hackman3d/orbit_controller:default:flash  # build and flash
+
+Or with the CLI:
+
+    qmk compile -kb hackman3d/orbit_controller -km viam
+
+### If `qmk compile` says "invalid keyboard_folder_or_all value"
+
+That means the QMK CLI is pointed at a *different* QMK tree than the one containing this
+keyboard. Check where it is looking:
+
+    qmk config user.qmk_home
+
+If it is not the checkout holding `keyboards/hackman3d/`, either point it here:
+
+    qmk config user.qmk_home=/path/to/this/qmk_firmware
+
+…or bypass the CLI and use `make` from the root of this tree, which resolves keyboards
+relative to the current directory. Note that the `QMK_HOME` **environment variable does not
+override** `user.qmk_home` — the CLI reads its config file, so exporting it has no effect.
+
+### Why the VIA keymap is called `viam`, not `via`
+
+QMK master rejects keymaps named `via`: `.gitignore` lists
+`/keyboards/**/keymaps/via/*`, and `qmk lint` fails with *"The keymap via should not exist!"*
+VIA keymaps were deprecated from the main repository. The keymap is therefore named `viam`
+(the convention used by the `ploopy_viamenus` project); it still sets `VIA_ENABLE = yes` and
+produces VIA-capable firmware.
+
+See the [build environment setup](https://docs.qmk.fm/#/getting_started_build_tools) and the
+[make instructions](https://docs.qmk.fm/#/getting_started_make_guide) for more information.
+Brand new to QMK? Start with our [Complete Newbs Guide](https://docs.qmk.fm/#/newbs).
+
+## Bootloader
+
+The Pro Micro uses the **Caterina** bootloader. Enter it by:
+
+* **Physical reset**: short RST to GND twice quickly.
+* **Bootmagic reset**: not available — `bootmagic` is disabled because all three buttons are
+  used by chords.
+* **Keycode in layout**: press the key mapped to `QK_BOOT` if you have added one.
+
+Caterina's bootloader window is short (~750 ms), so `make ...:flash` should be started before
+or immediately as you double-tap reset.
+
+You can flash freely between this firmware and the original Arduino sketch — the bootloader is
+untouched.
diff --git a/keyboards/hackman3d/orbit_controller/rules.mk b/keyboards/hackman3d/orbit_controller/rules.mk
