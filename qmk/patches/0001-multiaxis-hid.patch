diff --git a/keyboards/hackman3d/orbit_controller/orbit_autoreset.c b/keyboards/hackman3d/orbit_controller/orbit_autoreset.c
new file mode 100644
index 0000000000..cc08854255
--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/orbit_autoreset.c
@@ -0,0 +1,45 @@
+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Arduino-style "1200-baud touch" auto-reset into the bootloader.
+//
+// The Arduino IDE (and `arduino-cli`, PlatformIO, avrdude wrappers, and the
+// Web Serial uploaders) put a Pro Micro into its bootloader by opening the
+// device's CDC serial port at 1200 baud and immediately closing it. The
+// Arduino core watches for that magic baud rate and jumps to the bootloader.
+//
+// QMK does not implement this - I grepped tmk_core, quantum and platforms/avr
+// for "1200" and there is no handler - so once QMK is flashed the Arduino IDE
+// can no longer reset the board for you, and you are back to double-tapping
+// RST-to-GND inside Caterina's ~750 ms window.
+//
+// This file restores that behaviour. LUFA declares
+// EVENT_CDC_Device_LineEncodingChanged() as ATTR_WEAK aliased to an empty stub
+// (lib/lufa/LUFA/.../CDCClassDevice.h:376), and QMK never defines it, so we can
+// simply provide our own here. No core patch needed.
+//
+// Requires VIRTSER_ENABLE = yes, which is what creates the CDC interface.
+// Measured cost: 880 bytes of flash (11,920 -> 12,800 on the viam build).
+
+#include QMK_KEYBOARD_H
+
+#ifdef VIRTSER_ENABLE
+
+#    include <LUFA/Drivers/USB/USB.h>
+
+/* The de-facto standard magic baud rate, same value the Arduino cores use. */
+#    ifndef ORBIT_AUTORESET_BAUD
+#        define ORBIT_AUTORESET_BAUD 1200
+#    endif
+
+/* Called by LUFA whenever the host issues CDC SET_LINE_CODING. */
+void EVENT_CDC_Device_LineEncodingChanged(USB_ClassInfo_CDC_Device_t *const CDCInterfaceInfo) {
+    if (CDCInterfaceInfo->State.LineEncoding.BaudRateBPS == ORBIT_AUTORESET_BAUD) {
+        // Matches the Arduino core's behaviour: reset immediately. bootloader_jump()
+        // sets Caterina's boot key and triggers a watchdog reset, so the bootloader
+        // stays open long enough for the host to re-enumerate and upload.
+        bootloader_jump();
+    }
+}
+
+#endif  // VIRTSER_ENABLE
