@@ -0,0 +1,13 @@
+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+/* Three layers: base (6DOF), slicer short-press, slicer long-press. */
+#define DYNAMIC_KEYMAP_LAYER_COUNT 3
+
+/* Macros are meaningless on a 3-button device, and the default of 16 would
+ * claim ~800 bytes of the 32U4's 1KB EEPROM for the macro buffer, crowding
+ * out the tuning block. See qmk/05_SIZE_BUDGET.md section 3.
+ */
+#define DYNAMIC_KEYMAP_MACRO_COUNT 0
