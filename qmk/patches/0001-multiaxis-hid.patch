diff --git a/keyboards/hackman3d/orbit_controller/keymaps/default/keymap.c b/keyboards/hackman3d/orbit_controller/keymaps/default/keymap.c
new file mode 100644
index 0000000000..df09267233
--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/keymaps/default/keymap.c
@@ -0,0 +1,42 @@
+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include QMK_KEYBOARD_H
+#include "orbit_controller.h"
+
+/* The three physical buttons appear on three layers:
+ *
+ *   _BASE        6DOF mode - buttons are SpaceMouse buttons 1-3, reported in
+ *                the multi-axis button report (Report ID 3). Handled directly
+ *                by orbit_6dof.c, so the keycodes here are placeholders.
+ *
+ *   _SLICER      slicer mouse mode, SHORT press actions.
+ *   _SLICER_LONG slicer mouse mode, LONG press (>= 650 ms) actions.
+ *
+ * The slicer layers replace the 12 SLICER_SHORTCUT_* constants from the
+ * Arduino firmware. orbit_slicer.c looks the keycode up from the layer at
+ * press/release time via keymap_key_to_keycode(), which reads the *dynamic*
+ * keymap when VIA is enabled - so these are live-remappable with no reflash.
+ *
+ * Defaults below match Hackman3D_Orbit_Controller.ino v1.1.0 exactly.
+ */
+
+const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
+    /* NOTE while the port is still a skeleton: button 3 is QK_BOOT so there is
+     * a software route back into the bootloader. Once orbit_6dof.c is wired up
+     * this becomes KC_NO, because the 6DOF buttons bypass the keymap entirely.
+     * Recovery without it is a double-tap of RST-to-GND, which is fiddly. */
+    [_BASE] = LAYOUT(
+        KC_NO, KC_NO, QK_BOOT
+    ),
+
+    /* Short press: Tab / N / Ctrl+0 */
+    [_SLICER] = LAYOUT(
+        KC_TAB, KC_N, LCTL(KC_0)
+    ),
+
+    /* Long press: Shift+Alt+G / L / A */
+    [_SLICER_LONG] = LAYOUT(
+        LSA(KC_G), KC_L, KC_A
+    ),
+};
diff --git a/keyboards/hackman3d/orbit_controller/keymaps/viam/config.h b/keyboards/hackman3d/orbit_controller/keymaps/viam/config.h
