+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include QMK_KEYBOARD_H
+#include "orbit_controller.h"
+
+/* Same defaults as the `default` keymap - VIA overrides these from EEPROM
+ * once the user edits them. See keymaps/default/keymap.c for the layer
+ * rationale, and qmk/04_VIA_CUSTOM_MENUS.md for the live-tuning design.
+ */
+
+const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
+    /* NOTE while the port is still a skeleton: button 3 is QK_BOOT so there is
+     * a software route back into the bootloader. With VIA you can also remap
+     * this live. Once orbit_6dof.c is wired up this becomes KC_NO, because the
+     * 6DOF buttons bypass the keymap entirely. */
+    [_BASE] = LAYOUT(
+        KC_NO, KC_NO, QK_BOOT
+    ),
+
+    /* Short press: Tab / N / Ctrl+0 */
+    [_SLICER] = LAYOUT(
+        KC_TAB, KC_N, LCTL(KC_0)
+    ),
+
+    /* Long press: Shift+Alt+G / L / A */
+    [_SLICER_LONG] = LAYOUT(
+        LSA(KC_G), KC_L, KC_A
+    ),
+};
