diff --git a/keyboards/hackman3d/orbit_controller/config.h b/keyboards/hackman3d/orbit_controller/config.h
new file mode 100644
index 0000000000..feee5f3eee
--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/config.h
@@ -0,0 +1,57 @@
+// Copyright 2026 HackMan3D
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+/* ------------------------------------------------------------------------
+ * Multi-axis (3Dconnexion SpaceMouse) HID
+ *
+ * Enables the forked joystick descriptor in tmk_core that emits a
+ * Generic Desktop / Multi-axis Controller (usage 0x08) with three
+ * separate reports:
+ *     Report 1 = translation X/Y/Z   (3 x int16)
+ *     Report 2 = rotation Rx/Ry/Rz   (3 x int16)
+ *     Report 3 = 32 buttons
+ * This layout is what the 3DxWare driver binds against.
+ * See qmk/03_HID_DESCRIPTOR_FORK.md in the HackMan3D-Orbit-Controller repo.
+ * ---------------------------------------------------------------------- */
+#ifndef JOYSTICK_MULTIAXIS_ENABLE
+#    define JOYSTICK_MULTIAXIS_ENABLE
+#endif
+
+#define JOYSTICK_AXIS_COUNT 6
+#define JOYSTICK_AXIS_RESOLUTION 16
+#define JOYSTICK_BUTTON_COUNT 32
+
+/* ------------------------------------------------------------------------
+ * Debounce
+ *
+ * The Arduino firmware debounced the whole button mask as a unit ("stable"
+ * for 10 ms"), and the chord state machine depends on those exact
+ * semantics. That filter is ported verbatim in orbit_chords.c, so QMK's
+ * own per-key debounce is disabled to avoid stacking two filters and
+ * doubling button latency.
+ * ---------------------------------------------------------------------- */
+#define DEBOUNCE 0
+
+/* ------------------------------------------------------------------------
+ * Live-tunable configuration block (EEPROM)
+ *
+ * orbit_config_t is ~61 bytes; 64 gives a little room to grow.
+ * ---------------------------------------------------------------------- */
+#define EECONFIG_KB_DATA_SIZE 64
+
+/* ------------------------------------------------------------------------
+ * Pointing device (slicer mouse mode)
+ * ---------------------------------------------------------------------- */
+#define POINTING_DEVICE_TASK_THROTTLE_MS 1
+
+/* ------------------------------------------------------------------------
+ * Endpoint economy - the 32U4 has only 6 usable endpoints and we need one
+ * for the multi-axis interface plus two for VIA's raw HID.
+ *
+ * MOUSE_SHARED_EP is NOT defined here: enabling POINTING_DEVICE already
+ * defines it (see tmk_core/protocol/usb_descriptor.h), and redefining it
+ * is a -Werror build failure.
+ * ---------------------------------------------------------------------- */
+#define KEYBOARD_SHARED_EP
