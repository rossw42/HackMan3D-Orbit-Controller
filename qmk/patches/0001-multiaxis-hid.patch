--- /dev/null
+++ b/keyboards/hackman3d/orbit_controller/rules.mk
@@ -0,0 +1,35 @@
+# The 8 Hall-effect joystick channels are read with analogReadPin().
+ANALOG_DRIVER_REQUIRED = yes
+
+# Slicer mouse mode builds its own report_mouse_t in
+# pointing_device_driver_get_report().
+POINTING_DEVICE_DRIVER = custom
+
+# CDC serial interface disabled: with the dedicated multi-axis joystick
+# endpoint, VIRTSER would require 3 extra endpoints (7 total), which
+# exceeds the ATmega32U4's 6-endpoint limit (EP0 control + 6 usable).
+# The auto-reset via 1200-baud touch is therefore not available in this
+# build; use the physical reset button or qmk flash --no-serial-auto.
+# VIRTSER_ENABLE = yes
+# SRC += orbit_autoreset.c
+
+# Trims - none of these are meaningful for a 3-button 6DOF controller,
+# and turning them off is what keeps the VIA build comfortable on 28KB.
+MAGIC_ENABLE       = no
+GRAVE_ESC_ENABLE   = no
+SPACE_CADET_ENABLE = no
+
+# Tell protocol.mk not to force JOYSTICK_SHARED_EP; the multi-axis
+# descriptor needs its own dedicated interrupt endpoint (see Section 6
+# of qmk/03_HID_DESCRIPTOR_FORK.md).
+JOYSTICK_MULTIAXIS_ENABLE = yes
+
